# =============================================================================
# WealthFlow Platform - Global Environment Configuration Template
# Copy this file to .env or .env.development to configure your local environment
# =============================================================================

# Node Environment
NODE_ENV=development

# Backend Service
PORT=5000
HOST=0.0.0.0
APP_NAME="All-in-One Finance & Wealth Management Platform"
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8081

# PostgreSQL Database (Local or Containerized)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/finance_db?schema=public

# Redis Cache & Background Jobs
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=false

# Authentication Secrets (Generate 32+ char random strings)
JWT_SECRET=development-jwt-secret-key-32-chars-long-minimum!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=development-refresh-jwt-secret-key-32-chars-long!
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Security Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Social Authentication Providers (Optional, mocks used in development)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
APPLE_CLIENT_ID=com.wealthflow.app
APPLE_TEAM_ID=TEAMID1234
APPLE_KEY_ID=KEYID1234

# Transactional Email Verification & Password Reset (SMTP / Resend / SendGrid)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=security@wealthflow.com

# Mobile SMS OTP Authentication (Twilio / AWS SNS)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Logging & Telemetry
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true

# Web Frontend
VITE_API_URL=http://localhost:5000
