# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_NAME="All-in-One Finance & Wealth Management Platform"
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8081

# -----------------------------------------------------------------------------
# DATABASE (POSTGRESQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_db?schema=public

# -----------------------------------------------------------------------------
# REDIS CACHE & QUEUE
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# -----------------------------------------------------------------------------
# LOGGING & MONITORING
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true

# -----------------------------------------------------------------------------
# EXTERNAL INTEGRATIONS (PLACEHOLDERS)
# -----------------------------------------------------------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
ALPHA_VANTAGE_API_KEY=
FINANCIAL_MODELING_PREP_KEY=
OPENAI_API_KEY=

