NODE_ENV=production
PORT=5000
HOST=0.0.0.0
APP_NAME="All-in-One Finance Platform"
API_PREFIX=/api/v1
CORS_ORIGIN=https://app.wealthmanagement.com,https://api.wealthmanagement.com
DATABASE_URL=postgresql://prod_user:prod_secure_password@prod-pg-cluster.internal:5432/finance_db_prod?schema=public&sslmode=verify-full
REDIS_HOST=prod-redis-cluster.internal
REDIS_PORT=6379
REDIS_ENABLED=true
JWT_SECRET=prod-secret-key-must-be-rotated-and-stored-in-kms-or-secret-manager
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=prod-refresh-secret-key-stored-in-kms-or-secret-manager
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
LOG_LEVEL=warn
ENABLE_REQUEST_LOGGING=false

