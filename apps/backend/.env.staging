NODE_ENV=staging
PORT=5000
HOST=0.0.0.0
APP_NAME="All-in-One Finance Platform [Staging]"
API_PREFIX=/api/v1
CORS_ORIGIN=https://staging.finance.internal
DATABASE_URL=postgresql://staging_user:staging_password@staging-postgres.internal:5432/finance_db_staging?schema=public&sslmode=require
REDIS_HOST=staging-redis.internal
REDIS_PORT=6379
REDIS_ENABLED=true
JWT_SECRET=staging-secret-key-replace-with-vault-managed-key-32chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=staging-refresh-key-replace-with-vault-managed-key
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

