NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_NAME="All-in-One Finance Platform [Development]"
API_PREFIX=/api/v1
CORS_ORIGIN=*
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_db_dev?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=false
JWT_SECRET=dev-environment-super-secure-jwt-secret-key-32chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=dev-environment-refresh-secret-key-min-32chars
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true

